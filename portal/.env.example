DATABASE_URL=postgresql://portal:changeme@localhost:5099/akdmi_portal
JWT_SECRET=please-change-me-to-a-long-random-string-of-at-least-32-chars
PORTAL_PORT=3099
PORTAL_DB_PORT=5099
PORTAL_DB_PASSWORD=changeme

# Bearer token required by /api/admin/* routes and the /admin UI.
# Generate with e.g.  openssl rand -hex 32
PORTAL_ADMIN_TOKEN=please-change-me

# Absolute path to the akd-mi project root (the directory containing the `akd-mi` script
# and the `instances/`, `templates/` folders). Defaults to the parent of the portal cwd,
# which is correct when running the portal from inside this repo.
# AKDMI_PROJECT_DIR=/path/to/akd-mi-v2
